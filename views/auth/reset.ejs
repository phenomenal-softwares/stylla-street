<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>
   <%- include('../includes/navigation.ejs') %>

    <main>
        <% if (errorMessage) { %>
            <div class="user-message user-message--error"><%= errorMessage %></div>
        <% } %>
        <form class="login-form" action="/reset" method="POST">
            <div class="auth-form-heading">
                <p class="eyebrow eyebrow--dark">Account access</p>
                <h1>Reset your password</h1>
                <p>Enter your account email and we’ll send a password reset link.</p>
            </div>
            <div class="form-control">
                <label for="email">E-Mail</label>
                <input type="email" name="email" id="email">
            </div>
            <input type="hidden" value="<%= csrfToken %>" name="_csrf">
            <button class="btn" type="submit"><i class="fa-regular fa-paper-plane" aria-hidden="true"></i> Send reset link</button>
        </form>
    </main>
<%- include('../includes/end.ejs') %>