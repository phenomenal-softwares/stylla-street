<%- include('../includes/head.ejs') %>
</head>

<body>
    <%- include('../includes/navigation.ejs') %>

    <main class="listings-page">
        <div class="listings-heading">
            <div>
                <p class="eyebrow eyebrow--dark">Your Stylla Street</p>
                <h1>Watch listings</h1>
                <p>Manage your demo listings. Each account can share up to two watches.</p>
            </div>
            <% if (prods.length < 2) { %>
                <a class="btn" href="/admin/add-product"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add a watch</a>
            <% } %>
        </div>

        <% if (prods.length > 0) { %>
            <div class="grid listings-grid">
                <% for (let product of prods) { %>
                    <article class="card product-item listing-card">
                        <div class="card__image">
                            <img src="<%= product.imageUrl %>" alt="<%= product.title %>">
                        </div>
                        <div class="card__content">
                            <h2 class="product__title"><%= product.title %></h2>
                            <p class="product__price">$<%= product.price %></p>
                            <p class="product__description"><%= product.description %></p>
                            <p class="product__creator">Your listing</p>
                        </div>
                        <div class="card__actions">
                            <a href="/admin/edit-product/<%= product._id %>?edit=true" class="btn btn-secondary"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Edit</a>
                            <button class="btn danger js-delete-product" type="button" data-product-id="<%= product._id %>" data-csrf-token="<%= csrfToken %>"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Delete</button>
                        </div>
                    </article>
                <% } %>
            </div>
        <% } else { %>
            <div class="featured-empty">
                <i class="fa-regular fa-clock" aria-hidden="true"></i>
                <h3>No watches listed yet</h3>
                <p>Add your first watch to share it with the demo storefront.</p>
                <a class="btn" href="/admin/add-product">Add a watch</a>
            </div>
        <% } %>
    </main>

    <%- include('../includes/end.ejs') %>
