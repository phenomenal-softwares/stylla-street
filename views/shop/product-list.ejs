<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/product.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>

            <main class="catalog-page">
                <div class="catalog-heading">
                    <div>
                        <p class="eyebrow eyebrow--dark">The collection</p>
                        <h1>Find your next favourite</h1>
                        <p>Explore wristwatches shared by our demo community.</p>
                    </div>
                </div>
                <% if (prods.length > 0) { %>
                    <div class="grid">
                        <% for (let product of prods) { %>
                            <article class="card product-item">
                                <header class="card__header">
                                    <h1 class="product__title">
                                        <%= product.title %>
                                    </h1>
                                </header>
                                <div class="card__image">
                                    <img src="<%= product.imageUrl %>" alt="<%= product.title %>">
                                </div>
                                <div class="card__content">
                                    <h2 class="product__price">$
                                        <%= product.price %>
                                    </h2>
                                    <p class="product__description">
                                        <%= product.description %>
                                    </p>
                                    <p class="product__creator">Created by: <%= product.createdBy %></p>
                                </div>
                                <div class="card__actions">
                                    <a class="btn btn-secondary" href="/products/<%= product._id %>">View details <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                                     <% if (isAuthenticated) { %>
                                        <%- include('../includes/add-to-cart.ejs', {product: product}) %>
                                    <% } %>
                                </div>
                            </article>
                            <% } %>
                    </div>
                    <%- include('../includes/pagination.ejs', {
                        currentPage: currentPage,
                        hasNextPage: hasNextPage,
                        hasPreviousPage: hasPreviousPage,
                        nextPage: nextPage,
                        previousPage: previousPage,
                        lastPage: lastPage
                    }) %>
                    <% } else { %>
                        <div class="featured-empty">
                            <i class="fa-regular fa-clock" aria-hidden="true"></i>
                            <h3>No watches listed yet</h3>
                            <p>Check back later to explore the collection.</p>
                        </div>
                        <% } %>
            </main>
            <%- include('../includes/end.ejs') %>