<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/cart.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <main>
            <div class="catalog-heading">
                <p class="eyebrow eyebrow--dark">Your selection</p>
                <h1>Your demo cart</h1>
                <p>Items here are for demonstration only; no real purchase will be made.</p>
            </div>
            <% if (products.length > 0) { %>
                <ul class="cart__item-list">
                    <% products.forEach(p => { %>
                        <li class="cart__item">
                            <img class="cart__image" src="<%= p.productId.imageUrl %>" alt="<%= p.productId.title %>">
                            <h1><%= p.productId.title %></h1>
                            <h2>Quantity: <%= p.quantity %></h2>
                            <h2>$<%= p.price.toFixed(2) %></h2>
                            <form action="/cart-delete-item" method="POST">
                                <input type="hidden" value="<%= csrfToken %>" name="_csrf">
                                <input type="hidden" value="<%= p.productId._id %>" name="productId">
                                <button class="btn danger" type="submit">Delete</button>
                            </form>
                        </li>
                    <% }) %>
                </ul>
                <h2 class="centered cart-total">Demo total: $<%= totalPrice %></h2>
                <hr/>
                <div class="centered">
                    <a class="btn" href="/checkout">Continue to demo checkout <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            <% } else { %>
                <div class="featured-empty">
                    <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
                    <h3>Your cart is waiting</h3>
                    <p>Explore the collection and add a watch to your demo cart.</p>
                    <a class="btn" href="/products">Browse watches</a>
                </div>
            <% } %>
        </main>
        <%- include('../includes/end.ejs') %>